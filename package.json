{
  "name": "pi-mockdeck",
  "version": "0.1.0",
  "description": "A safe, theme-aware ASCII UI mockup gallery for Pi",
  "type": "module",
  "keywords": ["pi-package", "pi", "ascii", "wireframe", "mockup", "tui"],
  "license": "MIT",
  "files": ["extensions", "src", "skills", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "verify": "npm run check && npm test"
  },
  "engines": { "node": ">=22.19.0" },
  "pi": {
    "extensions": ["./extensions/index.ts"],
    "skills": ["./skills"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.7",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
